# ==============================================================================
# Rasid Backend - Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Supabase Managed Database & Storage (External Service)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
STORAGE_BUCKET_NAME=phone-images

# Authentication & Security (JWT)
JWT_SECRET=your_strong_jwt_secret_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Redis Cache Configuration
# In Docker Compose, the Redis service hostname is 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
